private theorem fresh_checks :
    let rows := cfRows fresh 256
    check rows.prod 2310 rows freshWitnesses = true := by
  simp only [cfRows, fresh_sqrt]
  decide +kernel

theorem fresh_obstruction {s : List ℕ} (sub : s.Sublist (cfRows fresh 256))
    (nonempty : s ≠ []) {M k : ℕ} (support : M ∣ 2310^k) :
    ¬ IsSquare (s.prod * M) :=
  no_supported_square fresh_checks sub nonempty support

theorem fresh_no_remainder {s : List ℕ} (sub : s.Sublist (cfRows fresh 256))
    (nonempty : s ≠ []) {M k : ℕ} (support : M ∣ 2310^k) (z : ℕ) :
    s.prod ≠ M*z^2 :=
  no_supported_remainder fresh_checks sub nonempty support z

