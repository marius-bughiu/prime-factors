import Mathlib.Data.Real.Basic
import Mathlib.Data.Nat.Sqrt
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

namespace PrimeFactors.ChebyshevQuarticScale

/-- Chebyshev expansion of the public sum and its two quadratic products. The
signed parameter t records factor order, while h is the even attenuation. -/
theorem expansion {x y K W D t h : ℝ} (hs : x+y=K+W*t^2) (hd : x-y=D*h*t) :
    let S := x+y
    let E₂ := 2*t^2-1
    let E₄ := 8*t^4-8*t^2+1
    let O₃ := 4*t^3-3*t
    S = K+W/2 + W/2*E₂ ∧
    x = S/2+D/2*h*t ∧
    S^2 = K^2+K*W+3*W^2/8 + (K*W+W^2/2)*E₂ + W^2/8*E₄ ∧
    S*x = S^2/2 + D/2*(K+3*W/4)*h*t + D*W/8*h*O₃ := by
  dsimp only
  have hx : x=(K+W*t^2+D*h*t)/2 := by linarith
  rw [hs,hx]
  constructor
  · ring
  constructor
  · ring
  constructor <;> ring

/-- The product of the triangular change-of-basis entries in the order
1, S, x, S², S*x. -/
theorem change_of_volume (W D : ℝ) :
    (W/2)*(D/2)*(W^2/8)*(D*W/8)=W^4*D^2/256 := by ring

/-- Bounding the even norm plus the odd norm bounds the trace.
This inequality works at either sign of the factor difference. -/
theorem contracting_odd {h : ℝ} (hh : |h|≤1) (e o : ℝ) :
    |e+h*o| ≤ |e|+|o| := by
  refine (abs_add_le ..).trans (add_le_add_left ?_ _)
  rw [abs_mul]
  simpa using mul_le_mul_of_nonneg_right hh (abs_nonneg o)

theorem volume_constants :
    ((17/9 : ℚ)/(4/3))*((81/32)/(2:ℚ))=459/256 ∧
    ((17/9 : ℚ)*(81/32))*(12/120) = 153/320 := by
  norm_num

/-- Input-only integer overestimate of W⁴D². The two adjacent integers
around sqrt(4N) bound the endpoints in the real-volume criterion. -/
def widthProduct (N U : ℕ) : ℕ :=
  let K := (4*N).sqrt
  let W := U+N/U-K
  W^5*(2*(K+1)+W)

private theorem width_eq {N U k q : ℕ}
    (hk : k*k≤4*N ∧ 4*N<(k+1)*(k+1)) (hq : q*U≤N ∧ N<(q+1)*U) :
    widthProduct N U = (U+q-k)^5*(2*(k+1)+(U+q-k)) := by
  unfold widthProduct
  rw [← Nat.eq_sqrt.mpr hk, Nat.div_eq_of_lt_le hq.1 hq.2]

