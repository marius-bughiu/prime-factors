import PrimeFactors.MaskedRelations
import Mathlib.FieldTheory.KummerPolynomial
import Mathlib.RingTheory.Polynomial.RationalRoot
import Mathlib.Tactic

/-! A cubic square certificate, its denominator-free modular readout, and
positive and negative square tests in the field generated by a cube root of 11.
The trace quartic occurs in Cohen and Thorne, Proposition 2.3(2),
*Dirichlet series associated to quartic fields with given cubic resolvent*. -/
namespace PrimeFactors.CubicTraceSquare
open Polynomial

/-- Coefficient convention for a monic cubic, including the signed constant term. -/
def cubic {R : Type*} [CommRing R] (a b c t : R) := t^3-a*t^2+b*t-c

def quartic {R : Type*} [CommRing R] (a b w t : R) := (t^2-a)^2-8*w*t-4*b

/-- The three conjugates of a square root exhibit its trace as a quartic root. -/
theorem trace_condition {R : Type*} [CommRing R] (x y z : R) :
    quartic (x^2+y^2+z^2) (x^2*y^2+y^2*z^2+z^2*x^2) (x*y*z) (x+y+z)=0 := by
  unfold quartic
  ring

theorem factor_identity {R : Type*} [CommRing R] {a b u v w : R}
    (first : u^2-a=2*v) (second : v^2-b=2*u*w) (z : R) :
    cubic u v w z*cubic u v w (-z) = -cubic a b (w^2) (z^2) := by
  unfold cubic
  linear_combination z^4*first - z^2*second

/-- A proposed rational trace gives a square root in the extension whenever
`β` differs from the scalar `-v`. This holds for every nonscalar `β`. -/
theorem recover {F : Type*} [Field F] {β a b u v w : F}
    (annihilates : cubic a b (w^2) β=0) (first : u^2-a=2*v) (second : v^2-b=2*u*w)
    (nonscalar : β+v≠0) : ((u*β+w)/(β+v))^2=β := by
  rw [div_pow]
  apply (div_eq_iff (pow_ne_zero _ nonscalar)).mpr
  unfold cubic at annihilates
  linear_combination -annihilates + β^2*first - β*second

/-- The trace quartic alone supplies the second coefficient in characteristic zero. -/
theorem recover_of_quartic {F : Type*} [Field F] [CharZero F] {β a b u w : F}
    (annihilates : cubic a b (w^2) β=0) (traceRoot : quartic a b w u=0)
    (den : β+(u^2-a)/2≠0) : ((u*β+w)/(β+(u^2-a)/2))^2=β := by
  apply recover annihilates (by ring) _ den
  unfold quartic at traceRoot
  linear_combination traceRoot/4

/-- Split the modular annihilator without inverting the reconstruction denominator. -/
theorem modular_product {N : ℕ} {a b u v w z : ZMod N}
    (annihilates : cubic a b (w^2) (z^2)=0) (first : u^2-a=2*v) (second : v^2-b=2*u*w) :
    cubic u v w z*cubic u v w (-z)=0 := by rw [factor_identity first second,annihilates,neg_zero]

/-- Either gcd can be tested on the original input; two nonzero factors of the
modular product guarantee a proper gcd. -/
theorem modular_split {N : ℕ} [NeZero N] {a b u v w z : ZMod N}
    (annihilates : cubic a b (w^2) (z^2)=0) (first : u^2-a=2*v) (second : v^2-b=2*u*w)
    (left : cubic u v w z≠0) (right : cubic u v w (-z)≠0) :
    1<(cubic u v w z).val.gcd N ∧ (cubic u v w z).val.gcd N<N := by
  have m := modular_product annihilates first second
  have valpos : 0<(cubic u v w z).val := Nat.pos_of_ne_zero fun h => left (by
    rw [←ZMod.natCast_zmod_val (cubic u v w z),h,Nat.cast_zero])
  have pos := Nat.gcd_pos_of_pos_right (cubic u v w z).val (NeZero.pos N)
  have ne : (cubic u v w z).val.gcd N ≠ 1 := by
    intro cop
    have unit : IsUnit (cubic u v w z) := by
      simpa only [ZMod.natCast_zmod_val] using (ZMod.isUnit_iff_coprime ..).mpr cop
    exact right (unit.mul_right_eq_zero.mp m)
  exact ⟨by omega,(Nat.le_of_dvd valpos (Nat.gcd_dvd_left _ _)).trans_lt (ZMod.val_lt _)⟩

/-- In a reduced polynomial quotient over a field a primitive denominator
cannot vanish: otherwise its numerator is nilpotent, hence zero modulo `f`. -/
theorem denominator_unit {F : Type*} [Field F] {f P B : F[X]} {v : F}
    (squarefree : Squarefree f) (degree : P.natDegree < f.natDegree)
    (primitive : v=0 → P≠0) (relation : f∣P^2-C (v^2)*B) : v≠0 := by
  intro zv
  have nil : f∣P^2 := by simpa [zv] using relation
  have div := (squarefree.dvd_pow_iff_dvd (by decide : 2≠0)).mp nil
  exact (not_le_of_gt degree) (natDegree_le_of_dvd div (primitive zv))

/-- Every degree-one root gives a square-character test, for any degree of
monic defining polynomial. Integer numerator/denominator data describe a
rational square, with a primitive numerator at the testing prime. -/
theorem integer_character {p : ℕ} [Fact p.Prime] {f P B : ℤ[X]} {v : ℤ}
    (monic : f.Monic) (squarefree : Squarefree (f.map (Int.castRingHom (ZMod p))))
    (degree : P.natDegree<f.natDegree) (primitive : (p:ℤ)∣v → ∃ i, ¬(p:ℤ)∣P.coeff i)
    (relation : f∣P^2-C (v^2)*B) (ρ : ZMod p) (root : (f.map (Int.castRingHom (ZMod p))).eval ρ=0) :
    ¬ (p:ℤ)∣v ∧ IsSquare ((B.map (Int.castRingHom (ZMod p))).eval ρ) := by
  let φ := Int.castRingHom (ZMod p)
  have mapped : f.map φ ∣ (P.map φ)^2 - C ((v:ZMod p)^2)*(B.map φ) := by
    simpa [φ,Polynomial.map_sub] using Polynomial.map_dvd φ relation
  have short : (P.map φ).natDegree < (f.map φ).natDegree := by
    rw [monic.natDegree_map]
    exact natDegree_map_le.trans_lt degree
  have prim (zero : (v:ZMod p)=0) : P.map φ≠0 := by
    obtain ⟨i,hi⟩ := primitive ((ZMod.intCast_zmod_eq_zero_iff_dvd ..).mp zero)
    intro h
    have red := congrArg (fun T : (ZMod p)[X] => T.coeff i) h
    apply hi
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd ..).mp (by simpa [φ] using red)
  have unit := denominator_unit squarefree short prim mapped
  have eval := eval_eq_zero_of_dvd_of_eval_eq_zero mapped root
  simp only [eval_sub,eval_pow,eval_mul,eval_C,sub_eq_zero] at eval
  refine ⟨fun h => unit ((ZMod.intCast_zmod_eq_zero_iff_dvd ..).mpr h),?_⟩
  apply (isSquare_iff_exists_sq _).mpr
  refine ⟨(P.map φ).eval ρ / v,?_⟩
  rw [div_pow]
  apply (eq_div_iff (pow_ne_zero _ unit)).mpr
  simpa only [mul_comm] using eval.symm

/-- The example field. -/
noncomputable def poly : ℚ[X] := X^3-C 11

theorem irreducible : Irreducible poly := by
  apply X_pow_sub_C_irreducible_of_prime (by decide)
  intro r eq
  have hz : aeval r (X^3-C (11:ℤ))=0 := by
    rw [map_sub,map_pow,aeval_X,aeval_C,eq]
    norm_num
  obtain ⟨z,hz,_⟩ := exists_integer_of_is_root_of_monic (monic_X_pow_sub_C _ (by decide)) hz
  rw [hz] at eq
  change (z:ℚ)^3=11 at eq
  have zeq : z^3=11 := by exact_mod_cast eq
  have hmod := congrArg (fun s : ℤ => (s : ZMod 7)) zeq
  have absent : ∀ y : ZMod 7, y^3≠11 := by decide +kernel
  exact absent z (by simpa using hmod)

abbrev K := AdjoinRoot poly
noncomputable abbrev α : K := AdjoinRoot.root poly

private theorem α_cube : α^3=11 := by
  convert root_X_pow_sub_C_pow 3 (11:ℚ) using 1

private theorem fmonic : poly.Monic := monic_X_pow_sub_C _ (by decide)
private noncomputable def basis : Basis (Fin 3) ℚ K :=
  (AdjoinRoot.powerBasis' fmonic).basis.reindex (finCongr (show poly.natDegree=3 from natDegree_X_pow_sub_C))

private theorem basis_apply (i : Fin 3) : basis i=α^i.val := by
  rw [basis,Basis.reindex_apply,PowerBasis.basis_eq_pow]
  rfl

/-- Coordinates in the example power basis, with no integrality restriction. -/
noncomputable def elem (a b c : ℚ) : K :=
  algebraMap ℚ K a+algebraMap ℚ K b*α+algebraMap ℚ K c*α^2

private theorem coordinates (a b c : ℚ) : basis.equivFun.symm ![a,b,c] = elem a b c := by
  rw [Basis.equivFun_symm_apply]
  simp [elem,basis_apply,Fin.sum_univ_succ,Algebra.smul_def,add_assoc]

/-- The two row triples live in the same irreducible cubic field. -/
theorem good_square : (α-2)*(3*α-2)*(α+4)=(7-2*α)^2 := by linear_combination 3*α_cube

theorem bad_product : (α+2)*(2*α-5)*(3*α-10)=166-20*α-23*α^2 := by linear_combination 6*α_cube

private theorem elem_surjective (v : K) : ∃ x y z : ℚ, v=elem x y z := by
  let l := basis.equivFun v
  refine ⟨l 0,l 1,l 2,?_⟩
  have eq : l=![l 0,l 1,l 2] := by funext i; fin_cases i <;> rfl
  rw [←coordinates,←eq]
  exact (basis.equivFun.symm_apply_apply v).symm

private theorem elem_eq {a b c x y z : ℚ} (hh : elem a b c=elem x y z) :
    a=x ∧ b=y ∧ c=z := by
  rw [←coordinates,←coordinates] at hh
  have h := basis.equivFun.symm.injective hh
  exact ⟨congrFun h 0,congrFun h 1,congrFun h 2⟩

private theorem elem_sq (x y z : ℚ) :
    (elem x y z)^2 = elem (x^2+22*y*z) (2*x*y+11*z^2) (y^2+2*x*z) := by
  simp only [elem,map_add,map_mul,map_pow,map_ofNat]
  linear_combination (2*algebraMap ℚ K y*algebraMap ℚ K z+(algebraMap ℚ K z)^2*α)*α_cube

/-- Determinant of multiplication by `x+yα+zα²` in the power basis, `α³=D`. -/
def pureNorm {R : Type*} [CommRing R] (D x y z : R) := x^3+D*y^3+D^2*z^3-3*D*x*y*z

private theorem elem_coord (a b c : ℚ) (i : Fin 3) : basis.repr (elem a b c) i = ![a,b,c] i := by
  change basis.equivFun (elem a b c) i= _
  rw [←coordinates,LinearEquiv.apply_symm_apply]

private theorem elem_mul_alpha (a b c : ℚ) : elem a b c*α=elem (11*c) a b := by
  simp only [elem,map_mul,map_ofNat]
  linear_combination algebraMap ℚ K c*α_cube

/-- Identification with the field norm itself, using the determinant in the
three-coordinate power basis. -/
theorem norm_elem (a b c : ℚ) : Algebra.norm ℚ (elem a b c)=pureNorm 11 a b c := by
  have col2 : elem a b c*α^2=elem (11*b) (11*c) a := by
    rw [sq,←mul_assoc,elem_mul_alpha,elem_mul_alpha]
  have mat : Algebra.leftMulMatrix basis (elem a b c) = !![a,11*c,11*b;b,a,11*c;c,b,a] := by
    ext i j
    rw [Algebra.leftMulMatrix_eq_repr_mul,basis_apply]
    fin_cases j <;> fin_cases i <;>
      simp [elem_coord,elem_mul_alpha,col2,Matrix.cons_val_zero,Matrix.cons_val_one]
  rw [Algebra.norm_eq_matrix_det basis,mat,Matrix.det_fin_three]
  simp [pureNorm]
  ring

/-- Coefficient arithmetic for squaring in a pure cubic. In particular the
quartic on the right must vanish if the left-hand element is a field square. -/
theorem pure_square {R : Type*} [CommRing R] (D x y z : R) :
    let a := x^2+2*D*y*z
    let b := 2*x*y+D*z^2
    let c := y^2+2*x*z
    pureNorm D a b c=(pureNorm D x y z)^2 ∧
      quartic (3*a) (3*a^2-3*D*b*c) (pureNorm D x y z) (3*x)=0 := by
  dsimp [pureNorm,quartic]
  constructor <;> ring

/-- The pure cubic characteristic polynomial annihilates its element. -/
theorem pure_annihilates {R : Type*} [CommRing R] {t D : R} (cube : t^3=D) (a b c : R) :
    cubic (3*a) (3*a^2-3*D*b*c) (pureNorm D a b c) (a+b*t+c*t^2)=0 := by
  rw [←cube]
  unfold cubic pureNorm
  ring

/-- In the example field this is an exact square test with rational inputs.
Only a single rational root of the trace quartic is needed. -/
theorem square_iff_trace {a b c w : ℚ} (nonconstant : b≠0 ∨ c≠0)
    (norm : pureNorm 11 a b c=w^2) : IsSquare (elem a b c) ↔
      ∃ u : ℚ, quartic (3*a) (3*a^2-33*b*c) w u=0 := by
  letI : Fact (Irreducible poly) := ⟨irreducible⟩
  constructor
  · rintro ⟨δ,sq⟩
    obtain ⟨x,y,z,rfl⟩ := elem_surjective δ
    rw [←pow_two,elem_sq] at sq
    obtain ⟨da,db,dc⟩ := elem_eq sq.symm
    have h := pure_square (11:ℚ) x y z
    dsimp only at h
    norm_num only [show (2:ℚ)*11=22 by norm_num] at h
    rw [da,db,dc,norm] at h
    have wc := sq_eq_sq_iff_eq_or_eq_neg.mp h.1
    rcases wc with hw|hw
    · exact ⟨3*x,hw ▸ h.2⟩
    · refine ⟨-(3*x),?_⟩
      rw [hw]
      simpa only [quartic,neg_sq,mul_neg,neg_mul,neg_neg] using h.2
  · rintro ⟨u,hu⟩
    let v := (u^2-3*a)/2
    have f1 : u^2-3*a=2*v := by dsimp [v]; ring
    have f2 : v^2-(3*a^2-33*b*c)=2*u*w := by
      dsimp [v]
      unfold quartic at hu
      linear_combination hu/4
    let φ := algebraMap ℚ K
    have F1 : (φ u)^2 - 3*φ a = 2*φ v := by simpa [φ] using congrArg φ f1
    have F2 : (φ v)^2 - (3*(φ a)^2-33*φ b*φ c)=2*φ u*φ w := by simpa [φ] using congrArg φ f2
    have HN : pureNorm 11 (φ a) (φ b) (φ c) = (φ w)^2 := by
      simpa only [pureNorm,map_add,map_sub,map_mul,map_pow,map_ofNat] using congrArg φ norm
    have ann := pure_annihilates α_cube (φ a) (φ b) (φ c)
    rw [HN,show (3:K)*11=33 by norm_num] at ann
    have den : elem a b c+φ v≠0 := by
      intro zero
      have same : elem a b c = elem (-v) 0 0 := by
        simpa only [elem,map_neg,map_zero,zero_mul,add_zero] using eq_neg_of_add_eq_zero_left zero
      obtain ⟨_,bz,cz⟩ := elem_eq same
      exact nonconstant.elim (fun h => h bz) (fun h => h cz)
    exact (isSquare_iff_exists_sq _).mpr ⟨_,(recover ann F1 F2 den).symm⟩

private theorem no_trace (q : ℚ) : quartic 498 67488 703 q ≠ 0 := by
  intro root
  let P : ℤ[X] := (X^2-C 498)^2-C 5624*X-C 269952
  have monic : P.Monic := by dsimp [P]; monicity!
  have ann : aeval q P=0 := by
    simp only [P,map_sub,map_pow,map_mul,aeval_X,aeval_C]
    norm_num
    unfold quartic at root
    linarith only [root]
  obtain ⟨m,hm,_⟩ := exists_integer_of_is_root_of_monic monic ann
  change q=(m:ℚ) at hm
  subst q
  unfold quartic at root
  have im : (m^2-498)^2-8*703*m-4*67488=0 := by exact_mod_cast root
  have mod5 := congrArg (fun z : ℤ => (z : ZMod 5)) im
  have absent : ∀ i : ZMod 5, (i^2-498)^2-8*703*i-4*67488≠0 := by decide +kernel
  exact absent m (by simpa using mod5)

/-- This near miss is not a square even in Q(α): rational coefficients and
arbitrary denominators for the proposed square root are permitted. -/
theorem bad_not_square : ¬ IsSquare ((α+2)*(2*α-5)*(3*α-10)) := by
  rw [bad_product]
  have target : (166-20*α-23*α^2)=elem 166 (-20) (-23) := by
    simp only [elem,map_neg,map_ofNat]
    ring
  rw [target,square_iff_trace (w:=703) (by norm_num) (by norm_num [pureNorm])]
  rintro ⟨u,h⟩
  norm_num at h
  exact no_trace u h

/-- The independent degree-one character at 5 rejects the same triple.
The defining polynomial is squarefree at that prime. -/
theorem bad_character : Squarefree (X^3-C (11:ZMod 5)) ∧
    (1:ZMod 5)^3=11 ∧ ¬IsSquare (((1:ZMod 5)+2)*(2*1-5)*(3*1-10)) := by
  letI : Fact (Nat.Prime 5) := ⟨by decide⟩
  refine ⟨(separable_X_pow_sub_C (n:=3) (11:ZMod 5) (by decide : (3:ZMod 5)≠0) (by decide)).squarefree,
    by decide,?_⟩
  rintro ⟨v,h⟩
  have reject : ∀ r : ZMod 5, ((1:ZMod 5)+2)*(2*1-5)*(3*1-10)≠r*r := by decide +kernel
  exact reject v h

/-- The rational products and signed algebraic norms for both distinct triples.
For a linear row the degree-three norm is `a³+11b³`. -/
theorem row_checks : (10:ℤ)^3-11=989 ∧ (8:ℤ)*28*14=56^2 ∧
    pureNorm (11:ℤ) (-2) 1 0 * pureNorm 11 (-2) 3 0 * pureNorm 11 4 1 0=255^2 ∧
    (12:ℤ)*15*20=60^2 ∧
    pureNorm (11:ℤ) 2 1 0 * pureNorm 11 (-5) 2 0 * pureNorm 11 (-10) 3 0=703^2 := by
  decide +kernel

/-- Actual algebraic norms for these elements; the negative case is a square
rational integer even though its element is proved nonsquare above. -/
theorem field_norms : Algebra.norm ℚ ((α-2)*(3*α-2)*(α+4)) = 255^2 ∧
    Algebra.norm ℚ ((α+2)*(2*α-5)*(3*α-10)) = 703^2 := by
  have good : (α-2)*(3*α-2)*(α+4)=elem 49 (-28) 4 := by
    rw [good_square]
    simp only [elem,map_neg,map_ofNat]
    ring
  have bad : (α+2)*(2*α-5)*(3*α-10)=elem 166 (-20) (-23) := by
    rw [bad_product]
    simp only [elem,map_neg,map_ofNat]
    ring
  rw [good,bad,norm_elem,norm_elem]
  norm_num [pureNorm]

theorem gcd_checks : (cubic (21:ℤ) 147 255 56).natAbs.gcd 989=23 ∧
    (cubic (21:ℤ) 147 255 (-56)).natAbs.gcd 989=43 ∧ 23*43=989 ∧
    Nat.Prime 23 ∧ Nat.Prime 43 := by decide +kernel

end PrimeFactors.CubicTraceSquare
