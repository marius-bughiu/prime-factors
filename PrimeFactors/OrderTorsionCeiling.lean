import PrimeFactors.PartialOrderLift
import PrimeFactors.SingleBaseRepeat
import PrimeFactors.OrderDivisorSumBits
import Mathlib.GroupTheory.Coset.Card

/-! The power kernel of a certified exponent divisor has a public cardinal.
It bounds the cardinal of every subgroup of units with that exponent by divisibility. -/
namespace PrimeFactors.OrderTorsionCeiling
open Finset

/-- The size predicted by a certificate that m divides the unit-group exponent. -/
def lift (n m : ℕ) := m * m.gcd (n-1)

private theorem arithmetic {x y m : ℕ} (hx : x≠0) (hy : y≠0) (hm : m∣x.lcm y) :
    (m.gcd x)*(m.gcd y) = m * m.gcd (x.gcd y) := by
  have hl := Nat.lcm_ne_zero hx hy
  have h : m≠0 := fun h => hl (Nat.zero_dvd.mp (h ▸ hm))
  have hd := (Nat.factorization_le_iff_dvd h hl).mpr hm
  have g (c : ℕ) := (Nat.gcd_pos_of_pos_left c (Nat.pos_of_ne_zero h)).ne'
  have gxy := (Nat.gcd_pos_of_pos_left y (Nat.pos_of_ne_zero hx)).ne'
  apply Nat.factorization_inj (mul_ne_zero (g x) (g y)) (mul_ne_zero h (g _))
  ext r
  specialize hd r
  rw [Nat.factorization_lcm hx hy, Finsupp.sup_apply] at hd
  rw [Nat.factorization_mul (g x) (g y),Nat.factorization_mul h (g _),
    Nat.factorization_gcd h hx,Nat.factorization_gcd h hy,Nat.factorization_gcd h gxy,
    Nat.factorization_gcd hx hy]
  simp only [Finsupp.add_apply,Finsupp.inf_apply]
  omega

/-- Public cardinal of all units killed by the certified exponent divisor. -/
theorem torsion_card {p q m : ℕ} [NeZero (p*q)] (hp : p.Prime) (hq : q.Prime)
    (ne : p≠q) (hm : m∣(p-1).lcm (q-1)) :
    (univ.filter fun x : (ZMod (p*q))ˣ => x^m=1).card=lift (p*q) m := by
  rw [SingleBaseRepeat.gap_count hp hq ne, arithmetic (by have := hp.one_lt; omega)
    (by have := hq.one_lt; omega) hm, ←PartialOrderLift.exponent_gcd hp.one_lt hq.one_lt]
  simp only [lift, ←Nat.gcd_assoc, Nat.gcd_eq_left hm]

/-- Full subgroup cardinal information cannot supply a larger divisor of the
totient than the previously known lift from its exponent. -/
theorem subgroup_card_dvd {p q m : ℕ} [NeZero (p*q)] (hp : p.Prime) (hq : q.Prime)
    (ne : p≠q) (hm : m∣(p-1).lcm (q-1)) (H : Subgroup (ZMod (p*q))ˣ)
    (killed : ∀ x ∈ H, x^m=1) : Nat.card H ∣ lift (p*q) m := by
  let K := (powMonoidHom (α:=(ZMod (p*q))ˣ) m).ker
  have sub : H ≤ K := fun x hx => killed x hx
  have card : Nat.card K = lift (p*q) m := by
    rw [←torsion_card hp hq ne hm]
    classical
    simp [K,Nat.card_eq_fintype_card,Fintype.card_subtype]
  exact card ▸ Subgroup.card_dvd_of_le sub

/-- Intrinsic form for the subgroup generated by any choice of bases. -/
theorem cardinal_from_exponent {p q : ℕ} [NeZero (p*q)] (hp : p.Prime) (hq : q.Prime)
    (ne : p≠q) (H : Subgroup (ZMod (p*q))ˣ) :
    Nat.card H ∣ lift (p*q) (Monoid.exponent H) := by
  apply subgroup_card_dvd hp hq ne
  · apply Monoid.exponent_dvd_of_forall_pow_eq_one
    intro x
    apply Subtype.ext
    exact orderOf_dvd_iff_pow_eq_one.mp (OrderDivisorSumBits.unit_order_dvd hp hq ne x.val)
  · intro x hx
    exact congrArg Subtype.val (Monoid.pow_exponent_eq_one (⟨x, hx⟩ : H))

/-- Combining exponent certificates effects precisely an lcm of the sum moduli. -/
theorem lift_lcm {n a b : ℕ} (hn : 1<n) (ha : a≠0) (hb : b≠0) :
    lift n (a.lcm b) = (lift n a).lcm (lift n b) := by
  have h : n-1≠0 := by omega
  have hl := Nat.lcm_ne_zero ha hb
  have g {c : ℕ} (hc : c≠0) := (Nat.gcd_pos_of_pos_left (n-1) (Nat.pos_of_ne_zero hc)).ne'
  unfold lift
  apply Nat.factorization_inj (mul_ne_zero hl (g hl))
    (Nat.lcm_ne_zero (mul_ne_zero ha (g ha)) (mul_ne_zero hb (g hb)))
  ext r
  rw [Nat.factorization_lcm (mul_ne_zero ha (g ha)) (mul_ne_zero hb (g hb)),
    Nat.factorization_mul hl (g hl),Nat.factorization_mul ha (g ha),
    Nat.factorization_mul hb (g hb),Nat.factorization_gcd hl h,
    Nat.factorization_gcd ha h,Nat.factorization_gcd hb h,Nat.factorization_lcm ha hb]
  simp only [Finsupp.add_apply,Finsupp.sup_apply,Finsupp.inf_apply]
  omega

private theorem order_from_checks {n g d : ℕ} (unit : g.Coprime n) (hd : 0<d)
    (kill : g^d ≡ 1 [MOD n]) (checks : ∀ i : Fin (d+1), i.val.Prime → i.val∣d →
      ¬g^(d/i.val) ≡ 1 [MOD n]) : GeometricCollisionGap.ord n g unit=d :=
  GeometricCollisionGap.stripped unit hd kill fun ℓ prime div =>
    checks ⟨ℓ, Nat.lt_succ_of_le (Nat.le_of_dvd hd div)⟩ prime div

/-- Exact orders determined and certified by computations modulo the product only. -/
theorem orders_12403 :
    GeometricCollisionGap.ord 12403 3 (by decide) = 78 ∧
    GeometricCollisionGap.ord 12403 11 (by decide) = 39 := by
  constructor <;> apply order_from_checks <;> decide +kernel

/-- The two compressed residues yield proper gcds. The original one-base
modulus already isolates the sum in the balanced search interval. -/
theorem split_12403 :
    let n := 12403
    let u := 3^26 % n
    let v := 11^13 % n
    u = 6738 ∧ v = 10688 ∧ (v-u).gcd n = 79 ∧ (v-(u^2%n)).gcd n = 157 ∧
    79*157=n ∧ Nat.Prime 79 ∧ Nat.Prime 157 ∧ lift n 78=6084 ∧ (n+1)%6084=236 := by
  decide +kernel

end PrimeFactors.OrderTorsionCeiling
