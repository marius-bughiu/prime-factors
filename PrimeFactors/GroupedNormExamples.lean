/-- The product-only probe returns both reported factors, larger first. -/
theorem adjacent_topProbe :
    topProbe adjacentN = some (adjacentLarge, adjacentSmall) := by
  let a : ℕ := 15*2^238+39054
  exact check _ _ _ (2^540) (a*(a+1)) 1 a
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

