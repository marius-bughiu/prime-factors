import PrimeFactors.GroupedNormFactors

namespace PrimeFactors.GroupedNormExamples
open GroupedNormFactors

set_option exponentiation.threshold 2048

/-- Verify the public floor square root by bounding the input between successive
squares. The other arithmetic checks certify the multiplier, the square hit,
and the decoder's reported output in its original order. -/
private theorem check (N p q h k z m : ℕ)
    (digits : let T := z+h*k
      T*T≤N ∧ N<(T+1)*(T+1) ∧ N-T^2=h)
    (hit : 0<k ∧ 0<z ∧ z≤h ∧ m*(m+1)=k*z)
    (decoded : fromRoot h k m=(p,q)) : topProbe N=some (p,q) := by
  have floor := (Nat.eq_sqrt.mpr ⟨digits.1,digits.2.1⟩).symm
  simpa only [decoded] using
    topProbe_accepts floor digits.2.2 hit.1 rfl hit.2.1 hit.2.2.1 hit.2.2.2

