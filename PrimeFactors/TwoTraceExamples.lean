import PrimeFactors.TwoTraceBudget
import PrimeFactors.ChebyshevQuarticScale
import PrimeFactors.Fermat

/-! Exact public two-trace cover minima on the two full-size inputs,
at block size one, with ordinary stride-24-compatible starts. -/

namespace PrimeFactors.TwoTraceExamples

open TwoTraceBudget

set_option exponentiation.threshold 8192
set_option maxRecDepth 12000

/-- Step common to all attainable weighted sums for this row. -/
def step (n a : ℕ) : ℕ := Nat.gcd 24 (2*(a+n))

/-- First admissible congruence label at or above the trace minimum. -/
def start (n a : ℕ) : ℕ :=
  let m := step n a
  let lo := ceilSqrt (4*a*n)
  lo+((a+n)%m+m-lo%m)%m

private theorem checked_start {n a r value : ℕ} (below : 4*a*n≤r^2)
    (previous : (r-1)^2<4*a*n)
    (phase : r+((a+n)%step n a+step n a-r%step n a)%step n a=value) : start n a=value := by
  have upper := ceilSqrt_le_iff.mpr below
  have root : ceilSqrt (4*a*n)=r := by
    by_contra ne
    have le : ceilSqrt (4*a*n)≤r-1 := by omega
    exact (not_le_of_gt previous) (ceilSqrt_le_iff.mp le)
  simpa only [start,root] using phase

/-- Number of permitted trace labels, charging one label per block. -/
def Minimum (n count : ℕ) : Prop :=
  IsMinimum n 1 (start n 1) (start n 2) (step n 1) (step n 2) count

/-- Exact optimum, stored in decimal to permit independent comparison. -/
def freshCount : ℕ :=
  

private theorem fresh_starts :
    start ChebyshevQuarticScale.fresh  ∧
    start ChebyshevQuarticScale.fresh  := by
  constructor
  · apply checked_start (r:)
    all_goals decide +kernel
  · apply checked_start (r:)
    all_goals decide +kernel

theorem fresh_minimum : Minimum ChebyshevQuarticScale.fresh freshCount := by
  unfold Minimum
  rw [fresh_starts.1,fresh_starts.2]
  apply check_sound (G:=freshCount-1)
    (j:)
    (u:)
    (v:=freshCount-)
  decide +kernel

/-- Exact optimum, stored in decimal to permit independent comparison. -/
def crossedCount : ℕ :=
  

private theorem crossed_starts :
    start ChebyshevQuarticScale.crossed  ∧
    start ChebyshevQuarticScale.crossed  := by
  constructor
  · apply checked_start (r:)
    all_goals decide +kernel
  · apply checked_start (r:)
    all_goals decide +kernel

theorem crossed_minimum : Minimum ChebyshevQuarticScale.crossed crossedCount := by
  unfold Minimum
  rw [crossed_starts.1,crossed_starts.2]
  apply check_sound (G:=crossedCount-1)
    (j:)
    (u:)
    (v:=crossedCount-)
  decide +kernel

theorem count_bits :
    2^1017<freshCount ∧ freshCount<2^1018 ∧ 2^1017<crossedCount ∧ crossedCount<2^1018 := by
  decide +kernel

end PrimeFactors.TwoTraceExamples
