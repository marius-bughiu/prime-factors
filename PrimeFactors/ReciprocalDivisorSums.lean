import PrimeFactors.ReciprocalDivisorClasses
import PrimeFactors.DivisorResidueCover
import PrimeFactors.StationaryRadixLimit

/-! A square root of −d modulo the public product, with d ≡ 3 mod 4,
restricts every odd factor coprime to d to the positive Jacobi units.
Pairing such units by their quotient bounds the set of possible sums. -/

namespace PrimeFactors.ReciprocalDivisorSums

open Finset ReciprocalSumCharacter ReciprocalWheel TraceFoldedRight

variable {d : ℕ} [NeZero d]

/-- The positive units can be tested by their Jacobi symbol without factoring d. -/
noncomputable def positive (d : ℕ) [NeZero d] : Finset (ZMod d)ˣ :=
  univ.filter fun x => sign (x : ZMod d) = 1

/-- All candidate sums generated by positive units. Enumerating the image
explicitly can cost a full period; the bound below counts distinct outputs. -/
noncomputable def sums (n : (ZMod d)ˣ) : Finset (ZMod d) := (positive d).image (trace n)

theorem pos_mem (x : (ZMod d)ˣ) : x ∈ positive d ↔ sign (x : ZMod d) = 1 := by
  simp [positive]

omit [NeZero d] in
/-- A public norm identity N ∣ t²+d controls every odd divisor of N. -/
theorem divisor_sign {N f : ℕ} {t : ℤ} (hd : d % 4 = 3) (odd : Odd f)
    (div : f ∣ N) (cop : N.Coprime d) (root : (N : ℤ) ∣ t^2+d) :
    sign (f : ZMod d) = 1 := by
  simpa only [← sign_cast, Int.cast_natCast] using
    ReciprocalDivisorClasses.divisor_of_witness hd odd div cop root

/-- All odd factor pairs of a product meeting the public norm constraint are
covered. Primality of either factor and a square root of N modulo d are optional. -/
theorem covers {p q : ℕ} {t : ℤ} (hd : d % 4 = 3) (hp : Odd p) (hq : Odd q)
    (cop : (p*q).Coprime d) (root : ((p*q : ℕ) : ℤ) ∣ t^2+d) :
    let n := ZMod.unitOfCoprime (p*q) cop
    sign (n : ZMod d) = 1 ∧ ((p+q : ℕ) : ZMod d) ∈ sums n := by
  let x := ZMod.unitOfCoprime p (cop.coprime_dvd_left (dvd_mul_right ..))
  let y := ZMod.unitOfCoprime q (cop.coprime_dvd_left (dvd_mul_left ..))
  let n := ZMod.unitOfCoprime (p*q) cop
  have hx : sign (x : ZMod d) = 1 := divisor_sign hd hp (dvd_mul_right ..) cop root
  have hy : sign (y : ZMod d) = 1 := divisor_sign hd hq (dvd_mul_left ..) cop root
  have prod : x*y = n := Units.ext (Nat.cast_mul ..).symm
  change sign (n : ZMod d) = 1 ∧ _ ∈ sums n
  constructor
  · rw [← prod, Units.val_mul, sign_mul, hx, hy, one_mul]
  · apply mem_image.mpr
    refine ⟨x,(pos_mem x).mpr hx,?_⟩
    change (x : ZMod d)+(↑(n*x⁻¹) : ZMod d) = _
    rw [← prod, mul_right_comm, mul_inv_cancel, one_mul]
    exact (Nat.cast_add ..).symm

private theorem half (hd : d % 4 = 3) (W : Finset (ZMod d)ˣ) (neg : ∀ x∈W, -x∈W) :
    2*(W.filter (fun x : (ZMod d)ˣ => sign (x : ZMod d) = 1)).card = W.card := by
  classical
  let P (x : (ZMod d)ˣ) := sign (x : ZMod d) = 1
  have flip (x : (ZMod d)ˣ) : P (-x) ↔ ¬ P x := by
    change sign (-(x : ZMod d)) = 1 ↔ _
    rw [sign_neg hd]; dsimp [P]; rcases ReciprocalDivisorClasses.unit_sign x with h | h <;> omega
  have eq : (W.filter P).card = (W.filter (fun x => ¬ P x)).card := by
    refine card_bij' (fun x _ => -x) (fun x _ => -x) ?_ ?_ ?_ ?_
    · intro x hx
      obtain ⟨mem,h⟩ := mem_filter.mp hx
      exact mem_filter.mpr ⟨neg x mem, fun opp => (flip x).mp opp h⟩
    · intro x hx
      obtain ⟨mem,h⟩ := mem_filter.mp hx
      exact mem_filter.mpr ⟨neg x mem,(flip x).mpr h⟩
    · simp
    · simp
  have h := filter_card_add_filter_neg_card_eq_card (s := W) P
  change 2*(W.filter P).card = _
  omega

theorem positive_card (hd : d % 4 = 3) : 2*(positive d).card = d.totient := by
  simpa only [positive, card_univ, ZMod.card_units_eq_totient] using
    half hd univ (fun _ _ => mem_univ _)

private theorem fixed_bound (n : (ZMod d)ˣ) :
    (DivisorResidueCover.roots n).card ≤ Nat.card (StationaryRadixLimit.Roots d) := by
  classical
  let R := DivisorResidueCover.roots n
  by_cases nonempty : R.Nonempty
  · obtain ⟨r,hr⟩ := nonempty
    have square (x : (ZMod d)ˣ) (hx : x ∈ R) : x^2=n := (mem_filter.mp hx).2
    let f (x : R) : StationaryRadixLimit.Roots d :=
      ⟨x.val/r, by rw [div_pow,square _ x.property,square _ hr,div_self']⟩
    have bound := Nat.card_le_card_of_injective f (by
      intro x y h
      exact Subtype.ext (div_left_injective (b := r) (congrArg Subtype.val h)))
    simpa only [Nat.card_eq_fintype_card,Fintype.card_coe,R] using bound
  · simpa only [← show R = DivisorResidueCover.roots n from rfl, not_nonempty_iff_eq_empty.mp nonempty,
      card_empty] using (Nat.zero_le (Nat.card (StationaryRadixLimit.Roots d)))

/-- Enumerate just the positive unit with the smaller ordinary residue in
each reciprocal pair. Distinct representatives can still have the same sum. -/
noncomputable def reps (n : (ZMod d)ˣ) : Finset (ZMod d)ˣ :=
  (positive d).filter (fun x : (ZMod d)ˣ => (x : ZMod d).val ≤ ((partner n x : (ZMod d)ˣ) : ZMod d).val)

private theorem stable {n : (ZMod d)ˣ} (hn : sign (n : ZMod d) = 1)
    {x : (ZMod d)ˣ} (hx : x ∈ positive d) : partner n x ∈ positive d := by
  have product : x * partner n x = n := (product_iff_partner ..).mpr rfl
  rw [← product, Units.val_mul, sign_mul, (pos_mem x).mp hx, one_mul] at hn
  exact (pos_mem _).mpr hn

/-- The reduced enumeration produces all the same sums. -/
theorem reps_complete (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    (reps n).image (trace n) = sums n := by
  apply Subset.antisymm (image_subset_image (filter_subset ..))
  intro z hz
  obtain ⟨x,hx,rfl⟩ := mem_image.mp hz
  by_cases low : (x : ZMod d).val ≤ ((partner n x : (ZMod d)ˣ) : ZMod d).val
  · exact mem_image.mpr ⟨x,mem_filter.mpr ⟨hx,low⟩,rfl⟩
  · have prod : x * partner n x = n := (product_iff_partner ..).mpr rfl
    exact mem_image.mpr ⟨partner n x,mem_filter.mpr ⟨stable hn hx,
      by simpa only [partner_partner] using le_of_not_ge low⟩,
      same_key ((mul_comm _ x).trans prod)⟩

/-- Exactly this many representative classes are traversed, including when two
different representatives subsequently produce the same sum. -/
theorem reps_count (hd : d % 4 = 3) (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    4*(reps n).card = d.totient + (DivisorResidueCover.roots n).card := by
  classical
  letI : LinearOrder (ZMod d)ˣ := LinearOrder.lift' (fun x : (ZMod d)ˣ => (x : ZMod d).val)
    (fun _ _ eq => Units.ext (ZMod.val_injective d eq))
  have orbit := orbit_count (positive d) (partner n) (fun _ => stable hn) (fun x _ => partner_partner n x)
  have fixed := half hd (DivisorResidueCover.roots n) (by
    intro x hx
    exact mem_filter.mpr ⟨mem_univ _,by simpa only [neg_sq] using (mem_filter.mp hx).2⟩)
  calc
    4*(reps n).card = 2*(2*(representatives (positive d) (partner n)).card) := by
      change 4*(reps n).card = 2*(2*(reps n).card)
      omega
    _ = _ := by
      rw [orbit, Nat.mul_add, positive_card hd, Nat.add_left_cancel_iff, ← fixed]
      congr 2
      ext x
      simp only [positive,DivisorResidueCover.roots,mem_filter,mem_univ,true_and]
      rw [←product_iff_partner n x x, ←pow_two]
      exact and_comm

/-- For a product with no unit square root, exactly a quarter of all units
are explored even before equal sum values are merged. -/
theorem reps_without_root (hd : d % 4 = 3) (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1)
    (absent : ∀ x : (ZMod d)ˣ, x^2 ≠ n) : 4*(reps n).card = d.totient := by
  have empty : DivisorResidueCover.roots n = ∅ :=
    filter_eq_empty_iff.mpr (fun x _ => absent x)
  simpa only [empty,card_empty,Nat.add_zero] using reps_count hd n hn

/-- A bound on distinct candidate sums, keeping the exact number of unit roots as correction. -/
theorem card_roots (hd : d % 4 = 3) (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    4*(sums n).card ≤ d.totient + (DivisorResidueCover.roots n).card := by
  rw [← reps_count hd n hn, ← reps_complete n hn]
  exact Nat.mul_le_mul_left _ card_image_le

/-- Uniform bound, including when the product has no square root modulo d. -/
theorem card_bound (hd : d % 4 = 3) (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    4*(sums n).card ≤ d.totient + Nat.card (StationaryRadixLimit.Roots d) :=
  (card_roots hd n hn).trans (Nat.add_le_add_left (fixed_bound n) _)

set_option maxRecDepth 16384 in
set_option maxHeartbeats 4000000 in
private theorem primorial_743 :
    (quotientBudgetPrimes 743).card = 132 ∧ 2^1025 < quotientBudgetWheel 743 := by
  change ((range 744).filter Nat.Prime).card = 132 ∧
    2^1025 < ∏ p ∈ (range 744).filter Nat.Prime, p
  decide +kernel

/-- Even after adjoining the prime 2, a positive odd d ≤ 2^1024 lies below
the product of the first 132 primes. Thus d has at most 130 distinct primes. -/
theorem torsion_1024 (hd : d % 4 = 3) (small : d ≤ 2^1024) :
    Nat.card (StationaryRadixLimit.Roots d) ≤ 2^130 := by
  have pos := NeZero.pos d
  have odd : ¬ 2 ∣ d := by omega
  have cop := Nat.prime_two.coprime_iff_not_dvd.mpr odd
  have dbl : 2*d ≤ 2^1025 := by omega
  have h := quotientBudget_primeFactors_below (m := 2*d) (by omega) (by decide : 1 ≤ 743)
    (dbl.trans_lt primorial_743.2)
  rw [primorial_743.1,cop.primeFactors_mul,Nat.prime_two.primeFactors,
    ← insert_eq,card_insert_of_not_mem (fun h => odd (Nat.dvd_of_mem_primeFactors h))] at h
  have kernel := StationaryRadixLimit.roots_factor_bound pos
  have plain : (∏ p ∈ d.primeFactors, (if p = 2 then 4 else 2)) = 2^d.primeFactors.card := by
    calc
      _ = ∏ _p ∈ d.primeFactors, (2:ℕ) := by
        apply prod_congr rfl
        intro p hp
        apply if_neg
        rintro rfl
        exact odd (Nat.dvd_of_mem_primeFactors hp)
      _ = _ := by simp
  rw [plain] at kernel
  exact kernel.trans (Nat.pow_le_pow_right (by decide) (by omega))

/-- The correction is at most 2^130 over the entire 1024-bit modulus range. -/
theorem card_1024 (hd : d % 4 = 3) (small : d ≤ 2^1024)
    (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    4*(sums n).card ≤ d.totient + 2^130 :=
  (card_bound hd n hn).trans (Nat.add_le_add_left (torsion_1024 hd small) _)

/-- Bound before deduplicating trace values. -/
theorem reps_1024 (hd : d % 4 = 3) (small : d ≤ 2^1024)
    (n : (ZMod d)ˣ) (hn : sign (n : ZMod d) = 1) :
    4*(reps n).card ≤ d.totient + 2^130 := by
  rw [reps_count hd n hn]
  exact Nat.add_le_add_left ((fixed_bound n).trans (torsion_1024 hd small)) _

/-- If a public modular square root e of n is also available, every generated
sum s must have nonnegative characters at s±2e. Each is a test on s alone.
The assertion is necessary over composite moduli. -/
theorem offset_signs (n : (ZMod d)ˣ) {e s : ZMod d} (square : e^2 = (n : ZMod d))
    (mem : s ∈ sums n) : 0 ≤ sign (s-2*e) ∧ 0 ≤ sign (s+2*e) := by
  obtain ⟨x,hx,rfl⟩ := mem_image.mp mem
  have hpos := (pos_mem _).mp hx
  have cleared : (x : ZMod d)*trace n x = (x:ZMod d)^2 + e^2 := by
    rw [trace, square]
    linear_combination (n:ZMod d)*(Units.mul_inv x)
  have minus : (x : ZMod d)*(trace n x - 2*e) = ((x:ZMod d)-e)^2 := by
    linear_combination cleared
  have plus : (x : ZMod d)*(trace n x + 2*e) = ((x:ZMod d)+e)^2 := by
    linear_combination cleared
  have nonneg (b u : ZMod d) (eq : (x:ZMod d)*b = u^2) : 0 ≤ sign b := by
    have h := congrArg sign eq
    rw [pow_two, sign_mul, hpos, one_mul, sign_mul] at h
    rw [h]; exact mul_self_nonneg _
  exact ⟨nonneg _ _ minus,nonneg _ _ plus⟩

private theorem sign15 (x : ZMod 15) : sign x =
    (if x ∈ ({1,2,4,8} : Finset (ZMod 15)) then 1 else
     if x ∈ ({7,11,13,14} : Finset (ZMod 15)) then -1 else 0) := by
  obtain ⟨v,hv,rfl⟩ : ∃ v : ℕ, v < 15 ∧ ((v:ℤ) : ZMod 15) = x :=
    ⟨x.val, x.val_lt, by simp⟩
  rw [sign_cast]
  interval_cases v <;> norm_num <;> decide +kernel

/-- The two cheap symbol tests admit eight classes modulo 15, although the
positive-unit pairs for N=391 give only three possible sum classes. -/
theorem composite_example :
    17*23 = (391 : ℕ) ∧ 79^2 + 15 = (16*391 : ℕ) ∧
    (391 : ZMod 15) = 1 ∧
    sums (1 : (ZMod 15)ˣ) = {2,8,10} ∧
    (univ.filter (fun s : ZMod 15 => 0 ≤ sign (s-2) ∧ 0 ≤ sign (s+2))) =
      {2,3,4,6,7,8,10,14} := by
  simp only [sums, positive, sign15]
  decide +kernel

end PrimeFactors.ReciprocalDivisorSums
