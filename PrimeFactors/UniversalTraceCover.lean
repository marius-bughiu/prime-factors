private def size : ℕ := 2^2044
def block : ℕ := 2^1011
private def slab (n : ℕ) := n/size-8
private def index (n : ℕ) := n%12/3
private def residue (i : ℕ) := if i=0 then 1 else if i=1 then 5 else if i=2 then 7 else 11
private def upper (j : ℕ) := (9+j)*size-1
private def source (j i : ℕ) := upper j-(upper j-residue i)%12
private def cap (j : ℕ) : Point := ⟨16,8+j⟩

private def raw (old : ℕ) (p : Piece) : Slope × ℕ :=
  (⟨p.a,p.b,p.significand*2^990,weightedStride old p.a p.b⟩,p.blocks)

private def rows (j i : ℕ) := (pieces j i).map (raw (source j i))
private def cuts (j i : ℕ) : List Point := (pieces j i).map fun p => ⟨p.numerator,p.denominator⟩
private def price : List (Slope×ℕ) → ℕ
  | [] => 0
  | e::rest => max 1 e.2+price rest

private def good (old : ℕ) (s : Slope) : Prop :=
  s.start^2 ≤ 4*s.a*s.b*old ∧ s.step=weightedStride old s.a s.b ∧
  0<s.b ∧ s.b≤8 ∧ s.b≤s.a ∧ s.a≤2*s.b ∧ s.a.Coprime s.b

private instance (old : ℕ) (s : Slope) : Decidable (good old s) := by unfold good; infer_instance

private def valid (j i : ℕ) : Bool :=
  let rs := rows j i
  decide (price rs≤19) && rs.all (fun e => decide (good (source j i) e.1)) &&
    SequentialTraceCover.check (source j i) (block-1) ⟨1,1⟩ (cap j) rs (cuts j i)

private theorem table : ∀ j : Fin 8, ∀ i : Fin 4, valid j i := by decide +kernel

private def rebaseRows (n : ℕ) : List (Slope×ℕ) → List (Slope×ℕ)
  | [] => []
  | e::rs => (rebase n e.1,max 1 e.2)::rebaseRows n rs

private theorem rebaseRows_eq (n : ℕ) (rs : List (Slope×ℕ)) :
    rebaseRows n rs = rs.map fun e => (rebase n e.1,max 1 e.2) := by
  induction rs with
  | nil => rfl
  | cons e rest ih => simp only [rebaseRows,List.map_cons,ih]

/-- Product-only schedule: choose a size interval and residue, then compute
its first admissible trace for the actual input at each selected slope. -/
def schedule (n : ℕ) : List (Slope×ℕ) :=
  rebaseRows n (rows (slab n) (index n))

private theorem price_rebase (n : ℕ) (rs : List (Slope×ℕ)) :
    cost (rs.map fun e => (rebase n e.1,max 1 e.2)) = price rs := by
  induction rs with
  | nil => rfl
  | cons e rs ih => change max 1 e.2+_ = max 1 e.2+_; exact congrArg (max 1 e.2+·) ih

private theorem raise_start {old m : ℕ} {e : Slope×ℕ} {r : Point} (h : good old e.1)
    (hit : covers old m e.1 e.2 r) : covers old m (rebase old e.1) e.2 r := by
  have st := (of_decide_eq_true (rebase_valid old e.1)).2.2.2.1
  have rise : e.1.start≤(rebase old e.1).start :=
    (Nat.pow_le_pow_iff_left (by decide : 2≠0)).mp (h.1.trans st)
  have step : e.1.step=(rebase old e.1).step := h.2.1
  have compare : cutoff m e.1 e.2 ≤ cutoff m (rebase old e.1) e.2 := by
    unfold cutoff; rw [step]; exact Nat.add_le_add_right rise _
  apply decide_eq_true
  exact (of_decide_eq_true hit).trans_le (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left compare 2))

private theorem source_bound {n M u : ℕ} (nu : n≤M) (small : u≤n) (same : n%12=u) :
    n≤M-(M-u)%12 ∧ n ≡ M-(M-u)%12 [MOD 12] := by
  have a := Nat.mod_add_div n 12
  have b := Nat.mod_add_div (M-u) 12
  have r := Nat.mod_lt (M-u) (by decide : 0<12)
  change _ ∧ n%12=(M-(M-u)%12)%12
  omega

private theorem unit_index {n : ℕ} (cop : n.Coprime 6) :
    index n<4 ∧ n%12=residue (index n) := by
  have two : ¬2∣n := by intro h; have := Nat.dvd_gcd h (by decide : 2∣6); rw [cop.gcd_eq_one] at this; omega
  have three : ¬3∣n := by intro h; have := Nat.dvd_gcd h (by decide : 3∣6); rw [cop.gcd_eq_one] at this; omega
  have r2 : (n%12)%2≠0 := by
    rw [Nat.mod_mod_of_dvd _ (by decide : 2∣12)]; exact fun z => two (Nat.dvd_of_mod_eq_zero z)
  have r3 : (n%12)%3≠0 := by
    rw [Nat.mod_mod_of_dvd _ (by decide : 3∣12)]; exact fun z => three (Nat.dvd_of_mod_eq_zero z)
  have finite : ∀ r : Fin 12, r.val%2≠0 → r.val%3≠0 → r.val/3<4 ∧ r.val=residue (r.val/3) := by decide
  exact finite ⟨n%12,Nat.mod_lt _ (by decide)⟩ r2 r3

private theorem size_grid {Q n : ℕ} (pos : 0<Q) (lo : 8*Q≤n) (hi : n<16*Q) :
    let j := n/Q-8
    j<8 ∧ (8+j)*Q≤n ∧ n≤(9+j)*Q-1 := by
  have small := (Nat.le_div_iff_mul_le pos).mpr lo
  have large := (Nat.div_lt_iff_lt_mul pos).mpr hi
  have bottom := Nat.div_mul_le_self n Q
  have top := Nat.lt_mul_div_succ n pos
  dsimp only
  rw [show 8+(n/Q-8)=n/Q by omega,show 9+(n/Q-8)=n/Q+1 by omega]
  rw [Nat.mul_comm Q] at top
  omega

private theorem price_room {B g : ℕ} (positive : 0<B) :
    (B-1)*g+1≤B*max 1 g := by
  obtain ⟨b,rfl⟩ := Nat.exists_eq_succ_of_ne_zero positive.ne'
  simp only [Nat.succ_sub_one,Nat.succ_mul]
  exact Nat.add_le_add (Nat.mul_le_mul_left b (le_max_right 1 g)) (le_max_left 1 g)

private theorem port_cover {n old B : ℕ} {rs : List (Slope×ℕ)} {L R : Point}
    (pos : 0<n) (positive : 0<B) (smaller : n≤old) (same : n ≡ old [MOD 12])
    (goodRows : ∀ e∈rs, good old e.1) (original : CoversRange old (B-1) rs L R) :
    CoversRange n B (rs.map fun e => (rebase n e.1,max 1 e.2)) L R := by
  intro r rd left right
  obtain ⟨e,he,hit⟩ := original r rd left right
  have prior := raise_start (goodRows e he) hit
  have shifted := rebase_transfer pos smaller (s:=(rebase _ e.1)) (stride_congr same _ _)
    (rebase_valid _ e.1) (price_room (g:=e.2) positive) prior
  exact ⟨_,List.mem_map_of_mem he,shifted⟩

private theorem apply_table {j i n : ℕ} (j8 : j<8) (i4 : i<4) (pos : 0<n)
    (smaller : n≤source j i) (same : n ≡ source j i [MOD 12]) :
    let out := (rows j i).map fun e => (rebase n e.1,max 1 e.2)
    cost out≤19 ∧
    (∀ e∈out, validStart n e.1 ∧ 0<e.1.b ∧ e.1.b≤8 ∧ e.1.b≤e.1.a ∧
      e.1.a≤2*e.1.b ∧ e.1.a.Coprime e.1.b) ∧ CoversRange n block out ⟨1,1⟩ (cap j) := by
  have data := table ⟨j,j8⟩ ⟨i,i4⟩
  simp only [valid,Bool.and_eq_true,decide_eq_true_eq] at data
  obtain ⟨⟨total,eligible⟩,part⟩ := data
  have valid_row : ∀ e∈rows j i, good (source j i) e.1 :=
    fun e he => of_decide_eq_true (List.all_eq_true.mp eligible e he)
  refine ⟨(price_rebase n _).trans_le total,?_,port_cover pos (by decide +kernel) smaller same valid_row
    (SequentialTraceCover.rational_cover part)⟩
  intro e he; obtain ⟨x,hx,rfl⟩ := List.mem_map.mp he
  exact ⟨rebase_valid n x.1,(valid_row x hx).2.2⟩

private theorem range_lo : 8*size=2^2047 := by decide +kernel
private theorem range_hi : 16*size=2^2048 := by decide +kernel

/-- Every rational ratio in the publicly determined slab is covered; all
weights are primitive, balanced and have denominator at most eight. -/
theorem universal {n : ℕ} (lo : 2^2047≤n) (hi : n<2^2048) (cop : n.Coprime 6) :
    cost (schedule n)≤19 ∧
    (∀ e∈schedule n, validStart n e.1 ∧ 0<e.1.b ∧ e.1.b≤8 ∧ e.1.b≤e.1.a ∧
      e.1.a≤2*e.1.b ∧ e.1.a.Coprime e.1.b) ∧
    CoversRange n block (schedule n) ⟨1,1⟩ (cap (slab n)) := by
  have rawLo : 8*size≤n := range_lo ▸ lo
  have rawHi : n<16*size := range_hi ▸ hi
  have grid := size_grid (by decide +kernel : 0<size) rawLo rawHi
  change slab n<8 ∧ _ ∧ n≤upper (slab n) at grid
  obtain ⟨ix,modulus⟩ := unit_index cop
  have old := source_bound grid.2.2 (modulus ▸ Nat.mod_le n 12) modulus
  change n≤source (slab n) (index n) ∧ n ≡ source (slab n) (index n) [MOD 12] at old
  rw [schedule,rebaseRows_eq]
  exact apply_table grid.1 ix ((by decide +kernel : 0<2^2047).trans_le lo) old.1 old.2

/-- A 2,048-bit product of two 1,024-bit primes has a genuine weighted trace
among the labels of the explicit schedule computed solely from the product. -/
theorem target {p q n : ℕ} (pair : p*q=n) (pp : p.Prime) (qp : q.Prime) (order : p≤q)
    (minP : 2^1023≤p) (maxQ : q<2^1024) (large : 2^2047≤n) :
    cost (schedule n)≤19 ∧ ∃ e∈schedule n, 0<e.1.b ∧ e.1.b≤8 ∧ e.1.a.Coprime e.1.b ∧
      ∃ t<block*e.2, e.1.start+e.1.step*t=e.1.a*p+e.1.b*q := by
  have small : n<2^2048 := calc
    n = p*q := pair.symm
    _ < 2^1024*2^1024 := Nat.mul_lt_mul_of_le_of_lt (order.trans maxQ.le) maxQ (by decide +kernel)
    _ = _ := by decide +kernel
  have primeCop {x : ℕ} (px : x.Prime) (bound : 2^1023≤x) : x.Coprime 6 := by
    apply px.coprime_iff_not_dvd.mpr
    intro h; have h' := Nat.le_of_dvd (by decide : 0<6) h
    exact (Nat.not_le_of_gt ((by decide +kernel : 6<2^1023).trans_le bound)) h'
  have cp := primeCop pp minP
  have cop := Nat.coprime_mul_iff_left.mpr ⟨cp,primeCop qp (minP.trans order)⟩
  obtain ⟨total,validRows,cover⟩ := universal large small (pair ▸ cop)
  have lo : 8*size≤n := range_lo ▸ large
  have hi : n<16*size := range_hi ▸ small
  have head := (size_grid (by decide +kernel : 0<size) lo hi).2.1
  change (8+slab n)*size≤n at head
  have sq : q^2≤16*size := (by decide +kernel : (2^1024)^2=16*size) ▸ Nat.pow_le_pow_left maxQ.le 2
  have band : q*(8+slab n)≤16*p := by
    apply (Nat.mul_le_mul_left_iff qp.pos).mp
    have a:=Nat.mul_le_mul_right (8+slab n) sq
    have b:=Nat.mul_le_mul_left 16 head
    have c : 16*n=16*(p*q) := congrArg (16*·) pair.symm
    nlinarith only [a,b,c]
  obtain ⟨e,he,found⟩ := cover ⟨q,p⟩ pp.pos (by simpa [before] using order) (decide_eq_true band)
  have valid := validRows e he
  exact ⟨total,e,he,valid.2.1,valid.2.2.1,valid.2.2.2.2.2,actual_index pair cp valid.1 found⟩

end PrimeFactors.UniversalTraceCover
