/-! An explicit universal schedule for two equal-width 1,024-bit primes. Each
of the eight size intervals and four admissible residues has a checked rational
partition. The large block length and the number of blocks are both explicit. -/

namespace PrimeFactors.UniversalTraceCover

open TraceCoverCertificate TraceCoverTransfer

set_option exponentiation.threshold 8192
set_option maxRecDepth 10000

structure Piece where
  a : ℕ
  b : ℕ
  blocks : ℕ
  numerator : ℕ
  denominator : ℕ
  significand : ℕ

