import PrimeFactors.EuclideanHeight

namespace PrimeFactors.EuclideanHeightExample

/- The factors label the two CRT signs for this previously certified input.
The Euclidean lower bound and the attaining fraction use the public modulus
and the displayed mixed root. -/

def modulus : ℕ :=
  

def mixed : ℕ :=
  

def minHeight : ℕ :=
  

def factorP : ℕ :=
  

def factorQ : ℕ :=
  

def numerator : ℕ :=
  14140193431255915314889052607647495409

def denominator : ℕ :=
  

set_option maxRecDepth 8192 in
theorem checked : EuclideanHeight.check 1134 modulus minHeight 0 1 modulus mixed = true := by
  decide +kernel

/-- Exact arithmetic checks the CRT signs, the attaining fraction and the
strict short-pair obstruction for every planted row through 2^2030. -/
theorem receipt :
    factorP*factorQ=modulus ∧ mixed%factorP=1 ∧ mixed%factorQ=factorQ-1 ∧
    mixed^2%modulus=1 ∧
    0<denominator ∧ denominator<modulus ∧ denominator*mixed%modulus=numerator ∧
    denominator*numerator=minHeight ∧ 2*minHeight^2≥modulus*2^2030 := by
  decide +kernel

/-- The checked minimum simultaneously bounds both mixed CRT signs for every
nonzero denominator below the modulus and every choice of signed quotient. -/
theorem all_denominators {v k : ℤ} (positive : 0<v) (small : v<modulus) :
    (minHeight : ℤ) ≤ v*|v*mixed-k*modulus| ∧
    (minHeight : ℤ) ≤ v*|v*((modulus : ℤ)-mixed)-k*modulus| :=
  ⟨EuclideanHeight.lower_bound checked positive small,
   EuclideanHeight.lower_bound_neg checked positive small⟩

theorem attained : ∃ k : ℤ,
    (denominator : ℤ)*|denominator*mixed-k*modulus|=minHeight := by
  refine ⟨((denominator*mixed/modulus : ℕ) : ℤ),?_⟩
  decide +kernel

/-- For a normalized ratio at either mixed sign, every short partner forces
the planted row's norm above 2^2030 on this input. -/
theorem excludes_small_row {u v g A : ℕ} (gp : 0<g) (vp : 0<v) (small : v<modulus)
    (mixedSign : (u : ℤ) ≡ (v : ℤ)*mixed [ZMOD (modulus : ℤ)] ∨
       -(u : ℤ) ≡ (v : ℤ)*mixed [ZMOD (modulus : ℤ)])
    (heights : 2*(g*u*v)^2<modulus*A) : 2^2030<A :=
  EuclideanHeight.exclude gp (EuclideanHeight.ratio_bound checked vp small mixedSign)
    (by decide +kernel) heights

def smallHeight : ℕ := minHeight/213
def firstNum : ℕ := smallHeight.gcd (numerator^2)
def firstDen : ℕ := smallHeight/firstNum
def secondNum : ℕ := denominator^2/firstDen
def secondDen : ℕ := numerator^2/firstNum

set_option maxRecDepth 8192 in
/-- Two primitive fractions attain a 2,031-bit first-row height with a short
partner on this same input. The cross products certify a common unit residue. -/
theorem upper_receipt :
    213 ∣ minHeight ∧ firstNum*secondDen=numerator^2 ∧ firstDen*secondNum=denominator^2 ∧
    firstNum.Coprime firstDen ∧ secondNum.Coprime secondDen ∧
    firstDen.Coprime modulus ∧ secondDen.Coprime modulus ∧ firstNum.Coprime modulus ∧
    (firstNum*secondDen)%modulus=(secondNum*firstDen)%modulus ∧
    firstNum*firstDen=smallHeight ∧ secondNum*secondDen=213*minHeight ∧
    2^2030<smallHeight ∧ smallHeight<2^2031 ∧
    2*smallHeight<modulus ∧ 2*(213*minHeight)<modulus := by
  decide +kernel

end PrimeFactors.EuclideanHeightExample
